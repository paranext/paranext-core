<usx version="3.0"><chapter style="c" number="3" altnumber="3 ca" pubnumber="3 cp" sid=" 3"/><char style="wj">wj marker </char><para style="p"><verse style="v" number="1" sid=""/>Notice that this chapter's attribute marker ca properly applies to the chapter as the altnumber attribute. However, its attribute marker cp should not be translated into pubnumber because it has markers in it. But Paratext 9.5 does not realize cp should be its own marker and improperly applies the part of cp before any markers as the pubnumber and puts the rest of the contents after the chapter marker. <verse style="v" number="2" sid=""/><verse style="v" number="3" sid=""/><verse style="v" number="4" sid=""/><verse style="v" number="5" sid=""/><verse style="v" number="6" sid=""/><verse style="v" number="7" sid=""/><verse style="v" number="8" sid=""/><verse style="v" number="9" sid=""/><verse style="v" number="10" sid=""/><verse style="v" number="11" sid=""/><verse style="v" number="12" sid=""/><verse style="v" number="13" sid=""/><verse style="v" number="14" sid=""/><verse style="v" number="15" sid=""/><verse style="v" number="16" sid=""/><verse style="v" number="17" sid=""/><verse style="v" number="18" sid=""/><verse style="v" number="19" sid=""/><verse style="v" number="20" sid=""/><verse style="v" number="21" sid=""/><verse style="v" number="22" sid=""/><verse style="v" number="23" sid=""/><verse style="v" number="24" sid=""/><verse style="v" number="25" sid=""/><verse style="v" number="26" sid=""/><verse style="v" number="27" sid=""/><verse style="v" number="28" sid=""/><verse style="v" number="29" sid=""/><verse style="v" number="30" sid=""/><verse style="v" number="31" sid=""/><verse style="v" number="32" sid=""/><verse style="v" number="33" sid=""/><verse style="v" number="34" sid=""/><verse style="v" number="35" sid=""/><verse style="v" number="36" sid=""/><verse style="v" number="37" sid=""/><verse style="v" number="38" sid=""/><verse style="v" number="39" sid=""/></para><chapter eid=" 3"/></usx>