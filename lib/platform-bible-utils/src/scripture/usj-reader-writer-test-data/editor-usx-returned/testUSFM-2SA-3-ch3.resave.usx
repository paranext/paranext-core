<usx version="3.0"><chapter number="3" style="c" altnumber="3 ca" pubnumber="3 cp" sid=" 3" /><char style="wj">wj marker </char><para style="p"><verse number="1" style="v" sid="" />Notice that this chapter's attribute marker ca properly applies to the chapter as the altnumber attribute. However, its attribute marker cp should not be translated into pubnumber because it has markers in it. But Paratext 9.5 does not realize cp should be its own marker and improperly applies the part of cp before any markers as the pubnumber and puts the rest of the contents after the chapter marker. <verse eid="" /><verse number="2" style="v" sid="" /><verse eid="" /><verse number="3" style="v" sid="" /><verse eid="" /><verse number="4" style="v" sid="" /><verse eid="" /><verse number="5" style="v" sid="" /><verse eid="" /><verse number="6" style="v" sid="" /><verse eid="" /><verse number="7" style="v" sid="" /><verse eid="" /><verse number="8" style="v" sid="" /><verse eid="" /><verse number="9" style="v" sid="" /><verse eid="" /><verse number="10" style="v" sid="" /><verse eid="" /><verse number="11" style="v" sid="" /><verse eid="" /><verse number="12" style="v" sid="" /><verse eid="" /><verse number="13" style="v" sid="" /><verse eid="" /><verse number="14" style="v" sid="" /><verse eid="" /><verse number="15" style="v" sid="" /><verse eid="" /><verse number="16" style="v" sid="" /><verse eid="" /><verse number="17" style="v" sid="" /><verse eid="" /><verse number="18" style="v" sid="" /><verse eid="" /><verse number="19" style="v" sid="" /><verse eid="" /><verse number="20" style="v" sid="" /><verse eid="" /><verse number="21" style="v" sid="" /><verse eid="" /><verse number="22" style="v" sid="" /><verse eid="" /><verse number="23" style="v" sid="" /><verse eid="" /><verse number="24" style="v" sid="" /><verse eid="" /><verse number="25" style="v" sid="" /><verse eid="" /><verse number="26" style="v" sid="" /><verse eid="" /><verse number="27" style="v" sid="" /><verse eid="" /><verse number="28" style="v" sid="" /><verse eid="" /><verse number="29" style="v" sid="" /><verse eid="" /><verse number="30" style="v" sid="" /><verse eid="" /><verse number="31" style="v" sid="" /><verse eid="" /><verse number="32" style="v" sid="" /><verse eid="" /><verse number="33" style="v" sid="" /><verse eid="" /><verse number="34" style="v" sid="" /><verse eid="" /><verse number="35" style="v" sid="" /><verse eid="" /><verse number="36" style="v" sid="" /><verse eid="" /><verse number="37" style="v" sid="" /><verse eid="" /><verse number="38" style="v" sid="" /><verse eid="" /><verse number="39" style="v" sid="" /><verse eid="" /></para><chapter eid=" 3" /></usx>