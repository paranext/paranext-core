#!/usr/bin/env sh

# ============================================
# Secret scanning (ALL branches)
# ============================================
if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "=========================================="
  echo "ERROR: gitleaks is not installed"
  echo "=========================================="
  echo "gitleaks is required to prevent committing secrets to this public repository."
  echo ""
  echo "Install it:"
  echo "  macOS:   brew install gitleaks"
  echo "  Windows: winget install Gitleaks.Gitleaks"
  echo "  Linux:   https://github.com/gitleaks/gitleaks/releases"
  echo ""
  echo "Then retry your commit."
  echo "=========================================="
  exit 1
fi

echo "Scanning for secrets..."
if ! gitleaks git --pre-commit --staged --no-banner; then
  echo ""
  echo "=========================================="
  echo "SECRET DETECTED — commit blocked"
  echo "=========================================="
  echo "Remove the secret from your staged files before committing."
  echo "See above for the file and line number."
  echo "=========================================="
  exit 1
fi
echo "No secrets found"

# ============================================
# Provisional dev-package builds (ALL branches)
# ============================================
# `npm run build:editor` stages your uncommitted scripture-editors working tree, and a dirty
# checkout stages whatever it happens to hold. `npm install` then records THAT package's dependency
# closure in package-lock.json, and committing the result publishes a lockfile built from work that
# exists only on your machine.
#
# Deliberately only those two. Staging a checkout that sits on a pushed feature branch is a normal
# way to develop both repos at once, and the lockfile that comes out of it is reproducible by
# anyone with that branch — so it is committable, and this does not block it.
if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'package-lock.json'; then
  # Driven by `dev-packages.json`, not by what is on disk. Nothing removes a staging folder when a
  # package is renamed or dropped, and a leftover one carrying an old `-local` marker would block
  # every lockfile commit while naming a package this repo no longer consumes — with no way to
  # clear it, since `npm install` only rewrites declared folders.
  PROVISIONAL=$(node -e '
    const fs = require("fs");
    const config = JSON.parse(fs.readFileSync("dev-packages.json", "utf8"));
    const folders = (config.repos ?? []).flatMap((repo) =>
      (repo.devPackages ?? []).map((devPackage) => devPackage.stagingFolder).filter(Boolean),
    );
    const provisional = folders.filter((folder) => {
      const marker = `dev-packages/staging/${folder}/.staged-from`;
      if (!fs.existsSync(marker)) return false;
      const stamp = fs.readFileSync(marker, "utf8");
      return (
        stamp.includes("-local") || stamp.includes("-dirty") || stamp.includes("-unpushed")
      );
    });
    process.stdout.write(provisional.map((f) => `dev-packages/staging/${f}`).join("\n"));
  ' 2>/dev/null || true)
  if [ -n "$PROVISIONAL" ]; then
    echo ""
    echo "=========================================="
    echo "PROVISIONAL DEV PACKAGE STAGED — commit blocked"
    echo "=========================================="
    echo "package-lock.json is staged, but these dev packages were staged from a local or dirty"
    echo "build rather than from a commit:"
    echo ""
    echo "$PROVISIONAL" | sed 's|^|  |'
    echo ""
    echo "Its dependency closure came from a local or dirty build, or from a commit that is not on"
    echo "the remote, so the lockfile would record something nobody else can reproduce. To fix:"
    echo ""
    echo "  npm install    # restages the pinned revision and rewrites package-lock.json"
    echo ""
    echo "If that install stops with \"has working changes\", the scripture-editors checkout it"
    echo "stages from is dirty: commit or stash there first, then run it again. It refuses to touch"
    echo "a dirty checkout, so the marker cannot clear until it is clean."
    echo ""
    echo "If the marker says -unpushed, the editor commit it was staged from exists only on your"
    echo "machine: push that branch, then run npm install again."
    echo ""
    echo "Then stage package-lock.json again."
    echo "=========================================="
    exit 1
  fi
fi

# ============================================
# Standard hooks (ALL branches)
# ============================================
# Block committing a package-lock.json whose root name has drifted (staged only). The root
# package.json deliberately has no "name" field (see adr-root-package-json-no-name in
# .context/standards/Architecture-Decisions.md), so npm falls back to the containing directory name:
# any clone or git worktree not named paranext-core rewrites it on npm install. This inspects the
# staged blob rather than the working tree, so a commit that does not touch the lockfile is never
# blocked, and a drifted staged copy is never missed because the working tree was fixed but not
# re-staged.
if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'package-lock.json'; then
  LOCK_ROOT_NAME=$(git show :package-lock.json | node -p "JSON.parse(require('fs').readFileSync(0, 'utf8')).name" 2>/dev/null)
  # An empty value means node could not parse the staged blob at all (unresolved conflict markers
  # are the usual cause); "undefined" means it parsed but carried no root name. Neither is drift, so
  # do not send the developer off to edit a name that is not the problem. stderr stays suppressed
  # above: without it a V8 stack trace buries the message below.
  if [ -z "$LOCK_ROOT_NAME" ] || [ "$LOCK_ROOT_NAME" = "undefined" ]; then
    echo ""
    echo "Error: could not read the root \"name\" from the staged package-lock.json."
    echo "Is it valid JSON with a root \"name\"? Unresolved conflict markers will do this."
    exit 1
  fi
  if [ "$LOCK_ROOT_NAME" != "paranext-core" ]; then
    echo ""
    echo "Error: package-lock.json's root \"name\" is \"$LOCK_ROOT_NAME\", expected \"paranext-core\"."
    echo "npm falls back to the directory name because the root package.json has no \"name\" field."
    echo "Do NOT add a \"name\" to package.json - that field is deliberately absent."
    echo "See adr-root-package-json-no-name in .context/standards/Architecture-Decisions.md."
    echo ""
    echo "If the lockfile has no other changes you want to keep, discard it:"
    echo "  git checkout HEAD -- package-lock.json"
    echo ""
    echo "Otherwise edit the root \"name\" (the second line of the file) back to"
    echo "\"paranext-core\" and re-stage:"
    echo "  git add package-lock.json"
    exit 1
  fi
fi

echo "Format and stylelint fixes..."
npm run lint:staged
echo "Format and stylelint fixes finished"

# ============================================
# AI-specific hooks (ai/* branches only)
# Husky runs hooks with sh, so we detect the branch with POSIX shell
# then delegate to bash for the AI validations.
# ============================================
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)

case "$BRANCH" in
  ai/*)
    # Audit logging — only on AI branches where .context exists
    AUDIT_LOG=".context/audit-logs/pre-commit.log"
    mkdir -p "$(dirname "$AUDIT_LOG")"
    log_hook() {
      echo "$(date -u +"%Y-%m-%dT%H:%M:%SZ")|pre-commit|$1" >> "$AUDIT_LOG" 2>/dev/null || true
    }

    STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -cE '\.(ts|tsx)$' || true)
    STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR | grep -cE '\.cs$' || true)
    log_hook "START|branch=$BRANCH|staged_ts=$STAGED_TS|staged_cs=$STAGED_CS"

    echo ""
    echo "=========================================="
    echo "AI Branch Detected: $BRANCH"
    echo "Running additional validations..."
    echo "=========================================="

    HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
    # shellcheck source=lib/ai-hooks.sh
    export AUDIT_LOG
    bash -e -c ". '$HOOK_DIR/lib/ai-hooks.sh' && run_all_ai_checks '$BRANCH'"
    AI_EXIT=$?
    log_hook "AI_HOOKS|exit_code=$AI_EXIT"
    if [ "$AI_EXIT" -ne 0 ]; then
      exit $AI_EXIT
    fi

    log_hook "END|status=success"
    ;;
esac
