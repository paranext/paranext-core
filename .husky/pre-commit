#!/usr/bin/env sh

# ============================================
# Secret scanning (ALL branches)
# ============================================
if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "=========================================="
  echo "ERROR: gitleaks is not installed"
  echo "=========================================="
  echo "gitleaks is required to prevent committing secrets to this public repository."
  echo ""
  echo "Install it:"
  echo "  macOS:   brew install gitleaks"
  echo "  Windows: winget install Gitleaks.Gitleaks"
  echo "  Linux:   https://github.com/gitleaks/gitleaks/releases"
  echo ""
  echo "Then retry your commit."
  echo "=========================================="
  exit 1
fi

echo "Scanning for secrets..."
if ! gitleaks git --pre-commit --staged --no-banner; then
  echo ""
  echo "=========================================="
  echo "SECRET DETECTED — commit blocked"
  echo "=========================================="
  echo "Remove the secret from your staged files before committing."
  echo "See above for the file and line number."
  echo "=========================================="
  exit 1
fi
echo "No secrets found"

# ============================================
# Provisional dev-package builds (ALL branches)
# ============================================
# A staged dev package is provisional when it did not come from the revision dev-packages.json
# pins: `npm run build:editor` stages your uncommitted working tree, a dirty checkout stages
# whatever it holds, and a checkout left on its own branch stages that branch. `npm install` then
# records THAT package's dependency closure in package-lock.json, and committing the result
# publishes a lockfile nobody else can reproduce. Staging marks all three in its `.staged-from`
# marker, so this is exact: it fires only when a provisional build is staged and the lockfile is
# going in.
if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'package-lock.json'; then
  PROVISIONAL=$(find dev-packages/staging -maxdepth 2 -name .staged-from \
    -exec grep -l -e '-local' -e '-dirty' -e '-offpin' {} + 2>/dev/null || true)
  if [ -n "$PROVISIONAL" ]; then
    echo ""
    echo "=========================================="
    echo "PROVISIONAL DEV PACKAGE STAGED — commit blocked"
    echo "=========================================="
    echo "package-lock.json is staged, but these dev packages were not staged from the revision"
    echo "dev-packages.json pins:"
    echo ""
    echo "$PROVISIONAL" | sed 's|/.staged-from$||;s|^|  |'
    echo ""
    echo "Its dependency closure is whatever your working tree had, so the lockfile would record"
    echo "something nobody else can reproduce. To fix:"
    echo ""
    echo "  npm install    # restages the pinned revision and rewrites package-lock.json"
    echo ""
    echo "Then stage package-lock.json again."
    echo "=========================================="
    exit 1
  fi
fi

# ============================================
# Standard hooks (ALL branches)
# ============================================
echo "Format and stylelint fixes..."
npm run lint:staged
echo "Format and stylelint fixes finished"

# ============================================
# AI-specific hooks (ai/* branches only)
# Husky runs hooks with sh, so we detect the branch with POSIX shell
# then delegate to bash for the AI validations.
# ============================================
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)

case "$BRANCH" in
  ai/*)
    # Audit logging — only on AI branches where .context exists
    AUDIT_LOG=".context/audit-logs/pre-commit.log"
    mkdir -p "$(dirname "$AUDIT_LOG")"
    log_hook() {
      echo "$(date -u +"%Y-%m-%dT%H:%M:%SZ")|pre-commit|$1" >> "$AUDIT_LOG" 2>/dev/null || true
    }

    STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -cE '\.(ts|tsx)$' || true)
    STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR | grep -cE '\.cs$' || true)
    log_hook "START|branch=$BRANCH|staged_ts=$STAGED_TS|staged_cs=$STAGED_CS"

    echo ""
    echo "=========================================="
    echo "AI Branch Detected: $BRANCH"
    echo "Running additional validations..."
    echo "=========================================="

    HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
    # shellcheck source=lib/ai-hooks.sh
    export AUDIT_LOG
    bash -e -c ". '$HOOK_DIR/lib/ai-hooks.sh' && run_all_ai_checks '$BRANCH'"
    AI_EXIT=$?
    log_hook "AI_HOOKS|exit_code=$AI_EXIT"
    if [ "$AI_EXIT" -ne 0 ]; then
      exit $AI_EXIT
    fi

    log_hook "END|status=success"
    ;;
esac
