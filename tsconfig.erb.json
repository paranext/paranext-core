{
  // Type-check gate for the build-time TypeScript under .erb, which the root tsconfig's `include`
  // ("src", "assets") leaves out: the startup-waterfall parser + CLI, and the third-party-notices
  // pipeline. Without this, a type error in either would keep CI green and surface only at manual
  // runtime - and the notices pipeline is ~4,700 lines that decide which licences may ship and then
  // write the artifact asserting it, so a renamed verdict field has to fail here rather than
  // produce a wrong document. Scoped to these files (not all of .erb/scripts) because the older
  // scripts there carry pre-existing type issues from their own heavy deps and are out of scope.
  // Test files are excluded for the same reason the root config excludes all `*.test.ts`: they rely
  // on Vitest's runtime rather than on tsc. Referenced by `npm run typecheck` via `typecheck:erb`.
  // Emits nothing - it is purely a gate.
  //
  // `types` is pinned to Node only so the root's `typeRoots` (which includes ./extensions/src)
  // doesn't drag extension .d.ts augmentations of papi-shared-types into a compile that doesn't
  // include src to define their base members.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    ".erb/scripts/startup-waterfall.ts",
    ".erb/scripts/startup-waterfall.util.ts",
    ".erb/scripts/notices-build-id.ts",
    ".erb/scripts/third-party-notices/*.ts",
    ".erb/configs/emit-shipped-modules-plugin.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
