{
  // Type-check gate for hand-picked CLI/parser pairs under .erb/scripts, which the root tsconfig's
  // `include` ("src", "assets") leaves out. Without this, a type error in one of them would keep CI
  // green and surface only at manual runtime. Scoped to these files (not all of .erb/scripts)
  // because the older scripts there carry pre-existing type issues from their own heavy deps and
  // are out of scope for this gate. The colocated *.util.test.ts files are not listed for the same
  // reason the root config excludes all `*.test.ts`: test files rely on Vitest's runtime, not tsc.
  // Referenced by `npm run typecheck` via `typecheck:erb`. Emits nothing - it is purely a gate.
  //
  // `types` is pinned to Node only so the root's `typeRoots` (which includes ./extensions/src)
  // doesn't drag extension .d.ts augmentations of papi-shared-types into a compile that doesn't
  // include src to define their base members.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    ".erb/scripts/startup-waterfall.ts",
    ".erb/scripts/startup-waterfall.util.ts",
    ".erb/scripts/generate-wire-surface.ts",
    ".erb/scripts/generate-wire-surface.util.ts",
    ".erb/scripts/generate-wire-surface.csharp.util.ts"
  ],
  "exclude": ["node_modules"]
}
