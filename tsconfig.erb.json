{
  // Type-check gate for the build-time and install-time TypeScript under .erb, which the root
  // tsconfig's `include` ("src", "assets") leaves out: the packaging clean-up entry point, the
  // startup-waterfall parser + CLI, the third-party-notices pipeline, and the two scripts npm runs
  // as `preinstall`/`postinstall`. Without this, a type error in any of them would keep CI green and
  // surface only at runtime - for the notices pipeline that is ~4,700 lines deciding which licenses
  // may ship and then writing the artifact asserting it, so a renamed verdict field has to fail here
  // rather than produce a wrong document; for the install scripts that runtime is every developer's
  // and every CI job's `npm install`. Scoped to these files (not all of .erb/scripts) because the
  // older scripts there carry pre-existing type issues from their own heavy deps and are out of
  // scope.
  // Test files are excluded for the same reason the root config excludes all `*.test.ts`: they rely
  // on Vitest's runtime rather than on tsc. Referenced by `npm run typecheck` via `typecheck:erb`.
  // Emits nothing - it is purely a gate.
  //
  // `types` is pinned to Node only so the root's `typeRoots` (which includes ./extensions/src)
  // doesn't drag extension .d.ts augmentations of papi-shared-types into a compile that doesn't
  // include src to define their base members.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "types": ["node"],
    // The install scripts are plain CommonJS with no import or export, so TypeScript would put
    // their top-level declarations in one shared global scope and report every name they have in
    // common as a redeclaration. Node decides CommonJS-vs-ESM from package.json, never from file
    // contents, so giving each file its own scope here changes nothing about how they run.
    "moduleDetection": "force"
  },
  "include": [
    ".erb/scripts/clean.ts",
    ".erb/scripts/startup-waterfall.ts",
    ".erb/scripts/startup-waterfall.util.ts",
    ".erb/scripts/stage-dev-packages.ts",
    ".erb/scripts/stage-dev-packages.util.ts",
    ".erb/scripts/postinstall.ts",
    ".erb/scripts/notices-build-id.ts",
    ".erb/scripts/third-party-notices/*.ts",
    ".erb/configs/emit-shipped-modules-plugin.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
