              "copyright": "Copyright (c) 2001 Example Runtime Foundation"
            }
          ]
        },
        {
          "platform": "Linux (snap)",
          "version": "1.8.2",
          "mechanism": "Debian packages staged into the snap",
          "evidence": {
            "file": ".erb/scripts/third-party-notices/__fixtures__/overlay/evidence.txt",
            "contains": "example-tool-linux-delivery"
          },
          "carriesNotices": false,
          "alsoContains": [
            {
              "name": "example-runtime",
              "version": "2.7.18",
              "spdx": ["ISC"]
            }
          ]
        }
      ]
