      "deliveries": [
        {
          "platform": "Windows",
          "version": "2.1.0",
          "mechanism": "NuGet package",
          "evidence": {
            "file": ".erb/scripts/third-party-notices/__fixtures__/overlay/evidence.txt",
            "contains": "example-tool-windows-delivery"
          },
          "carriesNotices": "LICENSE.txt beside the executable",
          "alsoContains": [
            {
              "name": "example-runtime",
              "version": "3.9.6",
