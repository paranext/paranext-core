{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "statusLine": {
    "type": "command",
    "command": ".claude/scripts/statusline.sh",
    "padding": 2
  },

  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Skill(test-runner)",
      "Skill(app-runner)",
      "mcp__ide__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(mkfs:*)",
      "Bash(chmod -R 777 /)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master)",
      "Bash(git push origin master:*)",
      "Bash(git checkout main && git push)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(HUSKY=0:*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/dist/**)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/*.map)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(chmod -R:*)",
      "Bash(chown -R:*)",
      "Bash(sudo:*)",
      "Bash(eval:*)",
      "Bash(npm publish:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },

  "hooks": {
    "SessionStart": [
        {
          "matcher": "startup|resume|clear",
          "hooks": [
            { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-git-state.sh" }
          ]
        }
      ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-guardrails.py"],
            "statusMessage": "Checking command safety..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "if": "Skill(visual-verification)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/preflight-check.sh >&2 || exit 2",
            "statusMessage": "Checking the app is running..."
          },
          {
            "type": "command",
            "if": "Skill(papi-client)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/scripts/preflight-check.sh >&2 || exit 2",
            "statusMessage": "Checking the app is running..."
          }
        ]
      },
      {
        "matcher": "mcp__atlassian__(create|edit)JiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/jira-create-context.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/edit-conventions.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-changed.sh",
            "timeout": 120,
            "statusMessage": "Linting changed files..."
          }
        ]
      }
    ]
  },

  "respectGitignore": true
}
